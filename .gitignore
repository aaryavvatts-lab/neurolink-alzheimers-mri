# Dataset and derived artifacts, never commit (1.4 GB raw, 4.9 GB cache)
# Anchored with a leading slash on purpose. A bare "data" also matches
# web/data, which holds the results the site needs at build time, and leaving
# it out breaks the deploy with no obvious cause.
/Data/
/data
cache/
runs/
.venv/
*.npy
*.pt
*.pth

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
_bench*.py

# Node / Next
web/node_modules/
web/.next/
web/out/
web/.vercel/

# onnxruntime WASM binaries: 43 MB, and `npm run build` regenerates them from
# node_modules via scripts/copy-ort.mjs. Committing them would quadruple the
# repo for files that are already a dependency.
web/public/ort/

# OS
.DS_Store

# Preprocessing-parity fixtures are derived from the dataset (raw pixel dumps).
# Regenerate with: python -m src.neurolink.dump_parity_fixtures
web/test/fixtures/
